+/* The display configuration is shared by all the desktops, and a virtual
+ * desktop replaces it with its own.  When a virtual desktop ends while
+ * programs keep running on the default desktop (a game in its own virtual
+ * desktop, started by a launcher that is not), give them back the host's
+ * configuration: switching a thread from a virtual desktop to a normal one
+ * makes win32u query the host displays again. */
+static DWORD WINAPI restore_host_displays( void *arg )
+{
+    HDESK desktop = OpenDesktopW( L"Default", 0, FALSE, DESKTOP_ALL_ACCESS );
+
+    if (desktop)
+    {
+        if (!SetThreadDesktop( desktop )) WARN( "could not switch to the default desktop\n" );
+        CloseDesktop( desktop );
+    }
+    return 0;
+}
