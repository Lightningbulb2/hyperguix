+            // xembedsniproxy proxies (Wine, Java, ...), draw their menu
+            // themselves: ask them to, as other hosts do.  The coordinates
+            // are a corner of this panel's output, near the panel, since an
+            // applet doesn't know where on the output it is; X11 clients
+            // open their menu there and keep it on screen.
+            Msg::ContextMenu(id) => {
+                let Some(menu) = self.menus.get(&id) else {
+                    return Task::none();
+                };
+                if menu.item.menu_proxy().is_some() || menu.item.is_menu() {
+                    return self.update(Msg::TogglePopup(id));
+                }
+                let (x, y) = self
+                    .outputs
+                    .get(&self.core.applet.output_name)
+                    .map_or((0, 0), |&(x, y, w, h)| match self.core.applet.anchor {
+                        PanelAnchor::Top => (x + w - 1, y),
+                        PanelAnchor::Left => (x, y + h - 1),
+                        PanelAnchor::Right | PanelAnchor::Bottom => (x + w - 1, y + h - 1),
+                    });
+                let item_proxy = menu.item.item_proxy().clone();
