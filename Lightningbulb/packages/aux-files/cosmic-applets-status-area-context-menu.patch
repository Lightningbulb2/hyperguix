     fn update(&mut self, message: Msg) -> app::Task<Msg> {
         match message {
             Msg::None => Task::none(),
+            Msg::Output(name, geometry) => {
+                match geometry {
+                    Some(geometry) => self.outputs.insert(name, geometry),
+                    None => self.outputs.remove(&name),
+                };
+                Task::none()
+            }
