+
+/// The output each app's windows were last closed on, by app id, so that the
+/// app opens there again (rather than wherever the pointer is).  Kept in
+/// $XDG_STATE_HOME/cosmic-comp/window-outputs, a line "APP-ID<TAB>OUTPUT" per
+/// app, so it survives restarts.
+#[derive(Debug, Default)]
+pub struct WindowOutputs {
+    outputs: HashMap<String, String>,
+    loaded: bool,
+}
+
+impl WindowOutputs {
+    fn path() -> Option<std::path::PathBuf> {
+        let state = std::env::var_os("XDG_STATE_HOME")
+            .filter(|dir| !dir.is_empty())
+            .map(std::path::PathBuf::from)
+            .or_else(|| {
+                std::env::var_os("HOME")
+                    .map(|home| std::path::PathBuf::from(home).join(".local/state"))
+            })?;
+        Some(state.join("cosmic-comp").join("window-outputs"))
+    }
+
+    fn load(&mut self) {
+        if std::mem::replace(&mut self.loaded, true) {
+            return;
+        }
+        let Some(text) = Self::path().and_then(|path| std::fs::read_to_string(path).ok())
+        else {
+            return;
+        };
+        self.outputs = text
+            .lines()
+            .filter_map(|line| line.split_once('\t'))
+            .map(|(app_id, output)| (app_id.to_string(), output.to_string()))
+            .collect();
+    }
+
+    pub fn get(&mut self, app_id: &str) -> Option<String> {
+        if app_id.is_empty() {
+            return None;
+        }
+        self.load();
+        self.outputs.get(app_id).cloned()
+    }
+
+    pub fn remember(&mut self, app_id: &str, output: String) {
+        if app_id.is_empty() {
+            return;
+        }
+        self.load();
+        if self.outputs.get(app_id) == Some(&output) {
+            return;
+        }
+        self.outputs.insert(app_id.to_string(), output);
+        let Some(path) = Self::path() else {
+            return;
+        };
+        let mut lines = self
+            .outputs
+            .iter()
+            .map(|(app_id, output)| format!("{app_id}\t{output}\n"))
+            .collect::<Vec<_>>();
+        lines.sort();
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        if let Err(err) = std::fs::write(&path, lines.concat()) {
+            tracing::warn!(?err, ?path, "Failed to save window outputs");
+        }
+    }
+}
