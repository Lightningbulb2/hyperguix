+
+/// Where an app's windows were last closed: the output, and for a floating
+/// window its geometry on that output.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WindowPlace {
+    pub output: String,
+    pub geometry: Option<Rectangle<i32, Local>>,
+}
+
+/// Where each app's windows were last closed, so that they open there again
+/// (rather than wherever the pointer is).  Per window, by app id and title
+/// (Steam's library, friends list and chats share one app id), and per app,
+/// from the last window of the app to close (normally its main window):
+/// used for a window without an entry of its own, with the geometry only if
+/// it is the app's first window.  Kept in
+/// $XDG_STATE_HOME/cosmic-comp/window-outputs, a line
+/// "APP-ID<TAB>TITLE<TAB>OUTPUT[<TAB>X<TAB>Y<TAB>WIDTH<TAB>HEIGHT]" per entry
+/// (TITLE empty for an app's), so it survives restarts.
+#[derive(Debug, Default)]
+pub struct WindowOutputs {
+    places: HashMap<(String, String), WindowPlace>,
+    loaded: bool,
+}
+
+impl WindowOutputs {
+    fn path() -> Option<std::path::PathBuf> {
+        let state = std::env::var_os("XDG_STATE_HOME")
+            .filter(|dir| !dir.is_empty())
+            .map(std::path::PathBuf::from)
+            .or_else(|| {
+                std::env::var_os("HOME")
+                    .map(|home| std::path::PathBuf::from(home).join(".local/state"))
+            })?;
+        Some(state.join("cosmic-comp").join("window-outputs"))
+    }
+
+    /// Titles go into a tab-separated line.
+    fn clean(title: &str) -> String {
+        title.replace(['\t', '\n', '\r'], " ")
+    }
+
+    fn parse(line: &str) -> Option<((String, String), WindowPlace)> {
+        let fields = line.split('\t').collect::<Vec<_>>();
+        // Older files had no TITLE field, and their per-app geometry could
+        // be any of the app's windows' (a splash screen's, say): keep only
+        // the output of those.
+        let (app_id, title, rest, old) = match fields.len() {
+            2 | 6 => (fields[0], "", &fields[1..], true),
+            3 | 7 => (fields[0], fields[1], &fields[2..], false),
+            _ => return None,
+        };
+        let numbers = rest[1..]
+            .iter()
+            .map(|field| field.parse::<i32>().ok())
+            .collect::<Option<Vec<_>>>()?;
+        let geometry = match numbers[..] {
+            [x, y, w, h] if w > 0 && h > 0 && !old => {
+                Some(Rectangle::new((x, y).into(), (w, h).into()))
+            }
+            _ => None,
+        };
+        Some((
+            (app_id.to_string(), title.to_string()),
+            WindowPlace {
+                output: rest[0].to_string(),
+                geometry,
+            },
+        ))
+    }
+
+    fn load(&mut self) {
+        if std::mem::replace(&mut self.loaded, true) {
+            return;
+        }
+        let Some(text) = Self::path().and_then(|path| std::fs::read_to_string(path).ok())
+        else {
+            return;
+        };
+        self.places = text.lines().filter_map(Self::parse).collect();
+    }
+
+    /// Where to open a window of APP-ID titled TITLE; OTHERS-OPEN tells
+    /// whether other windows of the app are open.
+    pub fn get(&mut self, app_id: &str, title: &str, others_open: bool) -> Option<WindowPlace> {
+        if app_id.is_empty() {
+            return None;
+        }
+        self.load();
+        let title = Self::clean(title);
+        if !title.is_empty()
+            && let Some(place) = self.places.get(&(app_id.to_string(), title))
+        {
+            return Some(place.clone());
+        }
+        let place = self.places.get(&(app_id.to_string(), String::new()))?;
+        Some(WindowPlace {
+            output: place.output.clone(),
+            geometry: if others_open { None } else { place.geometry },
+        })
+    }
+
+    /// LAST-OF-APP: whether no other window of the app stays open.
+    pub fn remember(&mut self, app_id: &str, title: &str, place: WindowPlace, last_of_app: bool) {
+        if app_id.is_empty() {
+            return;
+        }
+        self.load();
+        let mut changed = false;
+        let mut keys = vec![(app_id.to_string(), Self::clean(title))];
+        if last_of_app {
+            keys.push((app_id.to_string(), String::new()));
+        }
+        for key in keys {
+            // A window without a title only stands for its app when it is
+            // the app's last.
+            if key.1.is_empty() && !last_of_app {
+                continue;
+            }
+            if self.places.get(&key) != Some(&place) {
+                self.places.insert(key, place.clone());
+                changed = true;
+            }
+        }
+        if !changed {
+            return;
+        }
+        let Some(path) = Self::path() else {
+            return;
+        };
+        let mut lines = self
+            .places
+            .iter()
+            .map(|((app_id, title), place)| match place.geometry {
+                Some(g) => format!(
+                    "{app_id}\t{title}\t{}\t{}\t{}\t{}\t{}\n",
+                    place.output, g.loc.x, g.loc.y, g.size.w, g.size.h
+                ),
+                None => format!("{app_id}\t{title}\t{}\n", place.output),
+            })
+            .collect::<Vec<_>>();
+        lines.sort();
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        if let Err(err) = std::fs::write(&path, lines.concat()) {
+            tracing::warn!(?err, ?path, "Failed to save window outputs");
+        }
+    }
+}
