+/// Where an app's windows were last closed: the output, and for a floating
+/// window its geometry on that output.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WindowPlace {
+    pub output: String,
+    pub geometry: Option<Rectangle<i32, Local>>,
+}
+
+/// Where each app's windows were last closed, by app id, so that the app
+/// opens there again (rather than wherever the pointer is).  Kept in
+/// $XDG_STATE_HOME/cosmic-comp/window-outputs, a line
+/// "APP-ID<TAB>OUTPUT[<TAB>X<TAB>Y<TAB>WIDTH<TAB>HEIGHT]" per app, so it
+/// survives restarts.
+#[derive(Debug, Default)]
+pub struct WindowOutputs {
+    places: HashMap<String, WindowPlace>,
+    loaded: bool,
+}
+
+impl WindowOutputs {
+    fn path() -> Option<std::path::PathBuf> {
+        let state = std::env::var_os("XDG_STATE_HOME")
+            .filter(|dir| !dir.is_empty())
+            .map(std::path::PathBuf::from)
+            .or_else(|| {
+                std::env::var_os("HOME")
+                    .map(|home| std::path::PathBuf::from(home).join(".local/state"))
+            })?;
+        Some(state.join("cosmic-comp").join("window-outputs"))
+    }
+
+    fn parse(line: &str) -> Option<(String, WindowPlace)> {
+        let mut fields = line.split('\t');
+        let app_id = fields.next()?.to_string();
+        let output = fields.next()?.to_string();
+        let numbers = fields
+            .map(|field| field.parse::<i32>().ok())
+            .collect::<Option<Vec<_>>>()?;
+        let geometry = match numbers[..] {
+            [x, y, w, h] if w > 0 && h > 0 => Some(Rectangle::new((x, y).into(), (w, h).into())),
+            _ => None,
+        };
+        Some((app_id, WindowPlace { output, geometry }))
+    }
+
+    fn load(&mut self) {
+        if std::mem::replace(&mut self.loaded, true) {
+            return;
+        }
+        let Some(text) = Self::path().and_then(|path| std::fs::read_to_string(path).ok())
+        else {
+            return;
+        };
+        self.places = text.lines().filter_map(Self::parse).collect();
+    }
+
+    pub fn get(&mut self, app_id: &str) -> Option<WindowPlace> {
+        if app_id.is_empty() {
+            return None;
+        }
+        self.load();
+        self.places.get(app_id).cloned()
+    }
+
+    pub fn remember(&mut self, app_id: &str, place: WindowPlace) {
+        if app_id.is_empty() {
+            return;
+        }
+        self.load();
+        if self.places.get(app_id) == Some(&place) {
+            return;
+        }
+        self.places.insert(app_id.to_string(), place);
+        let Some(path) = Self::path() else {
+            return;
+        };
+        let mut lines = self
+            .places
+            .iter()
+            .map(|(app_id, place)| match place.geometry {
+                Some(g) => format!(
+                    "{app_id}\t{}\t{}\t{}\t{}\t{}\n",
+                    place.output, g.loc.x, g.loc.y, g.size.w, g.size.h
+                ),
+                None => format!("{app_id}\t{}\n", place.output),
+            })
+            .collect::<Vec<_>>();
+        lines.sort();
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        if let Err(err) = std::fs::write(&path, lines.concat()) {
+            tracing::warn!(?err, ?path, "Failed to save window outputs");
+        }
+    }
+}
