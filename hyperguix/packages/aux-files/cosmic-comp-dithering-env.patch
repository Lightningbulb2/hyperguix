+/// Set the connector property "dithering mode" (exposed by the NVIDIA
+/// driver, enum values such as "auto", "off", "static 2x2", "dynamic 2x2",
+/// "temporal", "on") as requested through the environment:
+/// COSMIC_DRM_DITHERING_<CONNECTOR> (e.g. COSMIC_DRM_DITHERING_DP_2 for
+/// "DP-2") or else COSMIC_DRM_DITHERING.  Returns Ok(None) when neither is
+/// set or the connector has no such property.
+pub fn set_dithering_from_env(
+    dev: &impl ControlDevice,
+    conn: connector::Handle,
+    output_name: &str,
+) -> Result<Option<String>> {
+    let per_connector = format!(
+        "COSMIC_DRM_DITHERING_{}",
+        output_name.to_ascii_uppercase().replace(['-', ' '], "_")
+    );
+    let Some(wanted) = std::env::var(&per_connector)
+        .or_else(|_| std::env::var("COSMIC_DRM_DITHERING"))
+        .ok()
+        .filter(|value| !value.is_empty())
+    else {
+        return Ok(None);
+    };
+    let Ok(prop) = get_prop(dev, conn, "dithering mode") else {
+        return Ok(None);
+    };
+    let info = dev.get_property(prop)?;
+    let property::ValueType::Enum(values) = info.value_type() else {
+        return Err(anyhow!("dithering mode is not an enum property"));
+    };
+    let (_, entries) = values.values();
+    let entry = entries
+        .iter()
+        .find(|entry| {
+            entry
+                .name()
+                .to_str()
+                .is_ok_and(|name| name.eq_ignore_ascii_case(wanted.trim()))
+        })
+        .ok_or_else(|| anyhow!("dithering mode has no value {:?}", wanted))?;
+    dev.set_property(conn, prop, entry.value())?;
+    Ok(Some(wanted))
+}
