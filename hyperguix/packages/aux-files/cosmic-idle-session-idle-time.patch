+    /// Milliseconds since the last user input, as KDE's implementation
+    /// returns; Steam polls this to decide when to mark the user Away.
+    fn get_session_idle_time(&self) -> u32 {
+        IDLE_SINCE
+            .lock()
+            .unwrap()
+            .map_or(0, |since| since.elapsed().as_millis().min(u32::MAX as u128) as u32)
+    }
+
