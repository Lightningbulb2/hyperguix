+use std::time::{Duration, Instant};
 
 use crate::{Event, EventSender};
 
+/// When the session went idle (no input), or `None` while it's in use.
+static IDLE_SINCE: Mutex<Option<Instant>> = Mutex::new(None);
+
+/// Record the session going idle (`is_idle`) `idle_for` ago, or resuming.
+pub fn set_session_idle(is_idle: bool, idle_for: Duration) {
+    *IDLE_SINCE.lock().unwrap() = is_idle.then(|| Instant::now() - idle_for);
+}
