+/// Linux's settings folder: `$XDG_CONFIG_HOME/isocast` when that is
+/// absolute, else `~/.config/isocast`; the support folder elsewhere, and
+/// while a `~/.isocast` from earlier builds is in use.
+pub fn config_folder() -> PathBuf {
+    xdg_folder("XDG_CONFIG_HOME", ".config")
+}
+
+/// Linux's state folder (logs, the install id): `$XDG_STATE_HOME/isocast`
+/// when that is absolute, else `~/.local/state/isocast`; the support
+/// folder elsewhere, and while a `~/.isocast` from earlier builds is in
+/// use.
+pub fn state_folder() -> PathBuf {
+    xdg_folder("XDG_STATE_HOME", ".local/state")
+}
+
+fn xdg_folder(variable: &str, fallback: &str) -> PathBuf {
+    let home = home_folder();
+    if !cfg!(target_os = "linux") || home.join(".isocast").is_dir() {
+        return support_folder();
+    }
+    let folder = std::env::var_os(variable)
+        .map(PathBuf::from)
+        .filter(|dir| dir.is_absolute())
+        .unwrap_or_else(|| home.join(fallback))
+        .join("isocast");
+    // Its files are written without creating their folder first (the
+    // support folder existed already for other reasons).
+    let _ = std::fs::create_dir_all(&folder);
+    folder
+}
+
