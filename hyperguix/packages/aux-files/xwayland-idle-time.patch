Keep MIT-SCREEN-SAVER in rootless Xwayland and count a forced screen saver
reset as user activity, so X11 programs get a usable idle time when a helper
resets the screen saver while the user is active on the Wayland side.

Steam doesn't read that idle time.  Once a second it opens a new connection,
calls QueryPointer on the root window and counts the user active when the
pointer is more than 5 pixels from where it last saw it -- and the X11
pointer only moves over X11 windows.  So each forced reset also toggles an
8 pixel shift of the position QueryPointer reports to connections that have
made fewer than 32 requests, while the pointer is outside X11 windows (on
the root window, where Xwayland puts it when the pointer is over Wayland
windows).  Events, the real pointer, long-lived clients and every client
while the pointer is over an X11 window -- a game -- are untouched: Wine
opens new connections for new threads, and a shifted position under a
locked cursor cost games their mouse look.

--- a/dix/events.c
+++ b/dix/events.c
@@ -5351,6 +5351,8 @@
  * Returns the current state and position of the client's ClientPointer to the
  * client.
  */
+extern int activityPointerNudge;       /* window.c */
+
 int
 ProcQueryPointer(ClientPtr client)
 {
@@ -5386,9 +5388,22 @@
         .rootY = pSprite->hot.y,
         .child = None
     };
+    /* Activity outside X11 windows doesn't move the X11 pointer; clients
+     * that poll its position to tell whether the user is there would see
+     * none.  Steam does that: every second it opens a connection, queries
+     * the pointer and counts a move of more than 5 pixels as activity.
+     * A forced screen saver reset flips activityPointerNudge; while set,
+     * shift the position reported to such throwaway connections -- only
+     * while the pointer is on the root window, i.e. over Wayland windows.
+     * Over an X11 window the pointer moves by itself, and a game's new
+     * connections (Wine opens one per thread) must see where it really is.
+     * Events and long-lived clients are unaffected.  */
+    if (activityPointerNudge && client->sequence < 32 &&
+        pSprite->win == pSprite->hot.pScreen->root)
+        rep.rootX += pSprite->hot.x >= 8 ? -8 : 8;
     if (pSprite->hot.pScreen == pWin->drawable.pScreen) {
         rep.sameScreen = xTrue;
-        rep.winX = pSprite->hot.x - pWin->drawable.x;
+        rep.winX = rep.rootX - pWin->drawable.x;
         rep.winY = pSprite->hot.y - pWin->drawable.y;
         for (t = pSprite->win; t; t = t->parent)
             if (t->parent == pWin) {
--- a/dix/window.c
+++ b/dix/window.c
@@ -3090,6 +3090,10 @@
 }
 
 #define RANDOM_WIDTH 32
+/* Flips on each forced screen saver reset; while set, ProcQueryPointer
+ * shifts the position it reports to short-lived connections.  */
+int activityPointerNudge = 0;
+
 int
 dixSaveScreens(ClientPtr client, int on, int mode)
 {
@@ -3097,8 +3101,16 @@
     XID vlist[2];
 
     if (on == SCREEN_SAVER_FORCER) {
-        if (mode == ScreenSaverReset)
+        if (mode == ScreenSaverReset) {
             what = SCREEN_SAVER_OFF;
+            /* Count a forced reset as user activity: MIT-SCREEN-SAVER
+             * measures idle time from the last device event.  Steam
+             * instead polls QueryPointer and takes a pointer that stays
+             * put for idleness, so make the next replies differ too.  */
+            UpdateCurrentTimeIf();
+            NoticeTime(inputInfo.pointer, currentTime);
+            activityPointerNudge ^= 1;
+        }
         else
             what = SCREEN_SAVER_ON;
         type = what;
--- a/hw/xwayland/xwayland-screen.c
